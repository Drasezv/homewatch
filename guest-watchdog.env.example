# /etc/guest-watchdog.env, readable by root only (chmod 600)

# Telegram-compatible sendMessage endpoint: the Bot API itself or your own relay in front of it.
# Leave empty to only log.
GW_NOTIFY_URL=https://api.telegram.org/bot<token>/sendMessage
GW_NOTIFY_CHAT=123456789
# optional, sent as "Authorization: Bearer ..." for a relay that wants one
GW_NOTIFY_TOKEN=
# en or ru
GW_LANG=en
# VMIDs the kernel's OOM killer should take last, space separated
GW_OOM_PROTECT=100
# 1 = only print what it would do
GW_DRY_RUN=0
