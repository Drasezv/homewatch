[Unit]
Description=homewatch: heartbeat sender
After=network.target
# a watchdog keeps trying, whatever the failure
StartLimitIntervalSec=0

[Service]
EnvironmentFile=/etc/homewatch/sender.env
ExecStart=/usr/bin/python3 -u /opt/homewatch/sender.py
SyslogIdentifier=homewatch-sender
# 1 s is below the receiver's DOWN_AFTER on purpose: a crash must not look like an outage
Restart=always
RestartSec=1
# 78 = the script refused its own config, restarting will not help
RestartPreventExitStatus=78

DynamicUser=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
UMask=0077
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
MemoryMax=32M

[Install]
WantedBy=multi-user.target
