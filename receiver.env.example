# shared secret, same value on both sides: openssl rand -hex 32
HB_KEY=
HB_PORT=29417
# seconds of silence before the alarm; with HB_INTERVAL=1 it is also the number of lost packets
DOWN_AFTER=5
# bot token from @BotFather
BOT_TOKEN=
# who gets the messages, comma separated. The first id is the owner and also gets service messages
CHAT_ID=
# after this many seconds of an outage, push an alarm to the phones in the siren file, then every 10 min; 0 = off
SIREN_AFTER=0
# en or ru
HB_LANG=en
